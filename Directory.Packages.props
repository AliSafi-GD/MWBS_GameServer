<Project>
  <!--
    Central Package Management: every NuGet version of the repository is set here, exactly (no 10.* or 2.*), so a build
    today and a build in a year get the same packages. Projects reference packages without a Version.
    To update: change the number here, then run run-tests.ps1 (or run-tests.sh).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Server">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Must match the LiteNetLib.dll that Unity clients put in Assets/Plugins (the UDP protocol has to agree). -->
    <PackageVersion Include="LiteNetLib" Version="1.3.5" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!-- The SDK smoke test compiles the Unity SDK sources outside Unity; in Unity the SDK gets Newtonsoft.Json from the
         com.unity.nuget.newtonsoft-json package instead. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
