<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Private=false + runtime excluded: the host provides Abstractions, don't ship a second copy. -->
    <ProjectReference Include="..\..\src\GameServer.Abstractions\GameServer.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The game's config ships with the module: config/<key>.json, copied next to the DLL by dotnet publish. -->
    <None Include="config\*.json" CopyToPublishDirectory="PreserveNewest" LinkBase="config" />
  </ItemGroup>
</Project>
