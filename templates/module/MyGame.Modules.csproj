<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The server provides this at run time (ExcludeAssets="runtime"), so the module does not ship a second copy. -->
    <PackageReference Include="GameServer.Abstractions" Version="ABSTRACTIONS_VERSION" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- The game's config ships with the module: config/<key>.json, copied next to the DLL by dotnet publish. -->
    <None Include="config\*.json" CopyToPublishDirectory="PreserveNewest" LinkBase="config" />
  </ItemGroup>
</Project>
