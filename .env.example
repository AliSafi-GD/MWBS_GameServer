# Copy to .env and change. Use different random values for every game in production.
# Generate a secret with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Key for the admin panel (/admin) and admin API. At least 24 characters, or leave empty to disable them.
ADMIN_KEY=replace-me-with-another-long-random-string

# For local development keep "change-me": it matches appsettings.Development.json.
# In production use a random password WITHOUT ; or = characters (it goes into a connection string).
DB_PASSWORD=change-me

# Google Play Games login: "Web application" OAuth client from Google Cloud (leave empty to disable).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chat/realtime protocols: websocket (ws/wss, path /ws), tcp (port 7351), or both: websocket,tcp
REALTIME_TRANSPORTS=websocket
# Protocols for matches: websocket, udp or websocket,udp
MATCH_TRANSPORTS=websocket
